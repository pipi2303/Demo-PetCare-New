APP_URL=
GEMINI_API_KEY=
GMAIL_APP_PASSWORD=
GMAIL_USER=
WA_TOKEN=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Optional — pin the credentials used when seeding brand-new accounts (a
# fresh install, or a new employee added to INITIAL_USERS). Leave unset and
# the server generates a random password/PIN per new account and prints it
# once to the server log on boot instead of using a shared guessable value.
# SEED_DEFAULT_PASSWORD=
# SEED_DEFAULT_PINS={"owner.klinik@petcare.id":"4821"}

# DATABASE_URL: Postgres connection string. In docker-compose this is wired
# automatically to the `postgres` service; only needed manually for local dev.
# CHANGE POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB below to real, unique
# values for any shared/production environment — "petcare/petcare" is a
# placeholder for local dev only and must never be used as-is on a server
# reachable outside your own machine.
DATABASE_URL=postgres://CHANGE_ME_USER:CHANGE_ME_STRONG_PASSWORD@localhost:5432/petcare
POSTGRES_USER=CHANGE_ME_USER
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=petcare