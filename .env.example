# === REQUIRED ===
POSTGRES_PASSWORD=use_a_strong_random_password_here

# === APP CONFIG ===
APP_URL=https://your-domain.com
FRONTEND_URL=https://your-domain.com
CLINIC_NAME=PetCare ERP

# === AI FEATURES ===
GEMINI_API_KEY=

# === EMAIL (password reset) ===
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=your_app_password

# === WHATSAPP ===
WA_TOKEN=

# === PAYMENT (Midtrans) ===
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# === BACKUP ===
# Directory inside container for backup files (mounted as Docker volume)
BACKUP_DIR=/app/backups
# Optional: rclone destination for cloud upload
# Examples:
#   AWS S3:  s3:your-bucket-name/petcare-backups
#   GCS:     gcs:your-bucket-name/petcare-backups
BACKUP_RCLONE_DEST=

# === SEED (first install only) ===
# SEED_DEFAULT_PASSWORD=temp_password_rotate_immediately
# SEED_DEFAULT_PINS={"email@example.com":"1234"}
